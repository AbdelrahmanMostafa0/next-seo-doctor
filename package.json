{
  "name": "next-seo-doctor",
  "version": "0.1.0",
  "description": "Post-build SEO validator for Next.js sites — crawls a running site and runs technical SEO checks with a colored terminal report.",
  "type": "module",
  "bin": {
    "next-seo-doctor": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "test": "vitest run",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "seo",
    "nextjs",
    "cli",
    "audit",
    "validator"
  ],
  "license": "MIT",
  "dependencies": {
    "cheerio": "^1.0.0",
    "fast-xml-parser": "^4.5.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.9.0"
  }
}
